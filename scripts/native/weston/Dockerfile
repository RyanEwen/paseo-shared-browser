FROM ubuntu@sha256:a2d43bffc46670d7108bb3c0468c67c5557c4c92e83e1e34cbff1322ad1b94dc
RUN apt-get update && apt-get install --yes --no-install-recommends build-essential meson ninja-build pkg-config python3 libwayland-dev libinput-dev libevdev-dev libdrm-dev libpixman-1-dev libxkbcommon-dev libudev-dev libegl1-mesa-dev libgles2-mesa-dev libgbm-dev libpng-dev libcairo2-dev libpango1.0-dev libglib2.0-dev libjpeg-dev libwebp-dev hwdata ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY weston-16.0.1.tar.xz wayland-protocols-1.49.tar.xz libdisplay-info-0.4.0.tar.xz ./
RUN echo '54f889d236d73f497e7929f355ad87f03c2bbcde945bb29fbbae2a4b3050e467 weston-16.0.1.tar.xz' | sha256sum -c - && echo 'ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14 wayland-protocols-1.49.tar.xz' | sha256sum -c - && echo '43b180baa143e2035654759d84e2b2f5ee77d5fe817c423838c7fe59c0d68459 libdisplay-info-0.4.0.tar.xz' | sha256sum -c -
# Weston 16.0.1 supports current libdisplay-info 0.4, unlike 16.0.0.
RUN tar -xf wayland-protocols-1.49.tar.xz && meson setup wp-build wayland-protocols-1.49 --prefix=/opt/shared-browser-weston -Dtests=false && meson install -C wp-build && tar -xf libdisplay-info-0.4.0.tar.xz && meson setup di-build libdisplay-info-0.4.0 --prefix=/opt/shared-browser-weston --libdir=lib && ninja -C di-build -j4 && meson install -C di-build
ENV PKG_CONFIG_PATH=/opt/shared-browser-weston/lib/pkgconfig:/opt/shared-browser-weston/share/pkgconfig
RUN tar -xf weston-16.0.1.tar.xz && meson setup weston-build weston-16.0.1 --prefix=/opt/shared-browser-weston --libdir=lib --buildtype=release --wrap-mode=nodownload -Dbackend-default=headless -Dbackend-headless=true -Dbackend-drm=false -Dbackend-wayland=false -Dbackend-x11=false -Dbackend-rdp=false -Dbackend-vnc=false -Dbackend-pipewire=false -Drenderer-gl=true -Drenderer-vulkan=false -Dxwayland=false -Dsystemd=false -Dshell-desktop=true -Dshell-ivi=false -Dshell-kiosk=false -Dshell-lua=false -Dcolor-management-lcms=false -Ddemo-clients=false -Dsimple-clients=[] -Dtools=[] -Dtests=false -Ddoc=false && ninja -C weston-build -j4 && meson install -C weston-build
RUN mkdir -p /opt/shared-browser-weston/licenses && cp weston-16.0.1/COPYING /opt/shared-browser-weston/licenses/WESTON-COPYING && cp libdisplay-info-0.4.0/LICENSE /opt/shared-browser-weston/licenses/LIBDISPLAY-INFO-LICENSE && dpkg-query -W > /opt/shared-browser-weston/build-packages.txt
